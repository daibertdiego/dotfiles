  },
  "Management Server Port": {
    "prefix": "management.server.port",
    "body": "management.server.port=${1:9090}",
    "description": "Actuator management port"
  },
  "Security User Name": {
    "prefix": "spring.security.user.name",
    "body": "spring.security.user.name=${1:admin}",
    "description": "Default security username"
  },
  "Security User Password": {
    "prefix": "spring.security.user.password",
    "body": "spring.security.user.password=${1:password}",
    "description": "Default security password"
