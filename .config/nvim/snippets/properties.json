{
  "Spring Application Name": {
    "prefix": "spring.application.name",
    "body": "spring.application.name=${1:myapp}",
    "description": "Name of the Spring Boot application"
  },
  "Spring Profiles Active": {
    "prefix": "spring.profiles.active",
    "body": "spring.profiles.active=${1:dev}",
    "description": "Active Spring profiles (comma-separated)"
  },
  "Server Port": {
    "prefix": "server.port",
    "body": "server.port=${1:8080}",
    "description": "HTTP server port"
  },
  "Server Context Path": {
    "prefix": "server.servlet.context-path",
    "body": "server.servlet.context-path=${1:/api}",
    "description": "Context path of the application"
  },
  "Datasource URL": {
    "prefix": "spring.datasource.url",
    "body": "spring.datasource.url=jdbc:${1|postgresql,mysql,h2,oracle|}://${2:localhost}/${3:database}",
    "description": "JDBC URL for database connection"
  },
  "Datasource Username": {
    "prefix": "spring.datasource.username",
    "body": "spring.datasource.username=${1:username}",
    "description": "Database username"
  },
  "Datasource Password": {
    "prefix": "spring.datasource.password",
    "body": "spring.datasource.password=${1:password}",
    "description": "Database password"
  },
  "Datasource Driver": {
    "prefix": "spring.datasource.driver-class-name",
    "body": "spring.datasource.driver-class-name=${1|org.postgresql.Driver,com.mysql.cj.jdbc.Driver,org.h2.Driver,oracle.jdbc.OracleDriver|}",
    "description": "JDBC driver class name"
  },
  "JPA DDL Auto": {
    "prefix": "spring.jpa.hibernate.ddl-auto",
    "body": "spring.jpa.hibernate.ddl-auto=${1|none,validate,update,create,create-drop|}",
    "description": "Database schema generation strategy"
  },
  "JPA Show SQL": {
    "prefix": "spring.jpa.show-sql",
    "body": "spring.jpa.show-sql=${1|true,false|}",
    "description": "Log SQL statements to console"
  },
  "JPA Format SQL": {
    "prefix": "spring.jpa.properties.hibernate.format_sql",
    "body": "spring.jpa.properties.hibernate.format_sql=${1|true,false|}",
    "description": "Format SQL statements in logs"
  },
  "Hibernate Dialect": {
    "prefix": "spring.jpa.properties.hibernate.dialect",
    "body": "spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.${1|PostgreSQLDialect,MySQL8Dialect,H2Dialect,Oracle12cDialect|}",
    "description": "Hibernate database dialect"
  },
  "SQL Init Mode": {
    "prefix": "spring.sql.init.mode",
    "body": "spring.sql.init.mode=${1|always,never,embedded|}",
    "description": "SQL initialization mode"
  },
  "Logging Level Root": {
    "prefix": "logging.level.root",
    "body": "logging.level.root=${1|INFO,DEBUG,WARN,ERROR,TRACE|}",
    "description": "Root logging level"
  },
  "Logging Level Package": {
    "prefix": "logging.level",
    "body": "logging.level.${1:com.example}=${2|DEBUG,INFO,WARN,ERROR,TRACE|}",
    "description": "Logging level for specific package"
  },
  "Logging File Name": {
    "prefix": "logging.file.name",
    "body": "logging.file.name=${1:logs/application.log}",
    "description": "Log file path and name"
  },
  "Logging Pattern Console": {
    "prefix": "logging.pattern.console",
    "body": "logging.pattern.console=%d{yyyy-MM-dd HH:mm:ss} - %msg%n",
    "description": "Console logging pattern"
  },
  "Management Endpoints Exposure": {
    "prefix": "management.endpoints.web.exposure.include",
    "body": "management.endpoints.web.exposure.include=${1|*,health\\,info,health|}",
    "description": "Exposed actuator endpoints"
  },
  "Management Health Show Details": {
    "prefix": "management.endpoint.health.show-details",
    "body": "management.endpoint.health.show-details=${1|always,when-authorized,never|}",
